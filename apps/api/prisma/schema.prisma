// Все суммы — демо-монеты в сотых долях (1 coin = 100). Реальных денег в системе нет.
// SQLite для нулевой настройки; для прода меняется provider на "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(cuid())
  nickname           String          @unique
  passwordHash       String
  telegramId         String?         @unique
  telegramUsername   String?
  isBot              Boolean         @default(false)
  isAdmin            Boolean         @default(false)
  isBanned           Boolean         @default(false)
  balance            Int             @default(0)
  lastDailyAt        DateTime?
  serverSeed         String
  serverSeedHash     String
  clientSeed         String
  nonce              Int             @default(0)
  prevServerSeed     String?
  prevServerSeedHash String?
  createdAt          DateTime        @default(now())
  transactions       Transaction[]
  inventory          InventoryItem[]
  battleSlots        BattlePlayer[]
  promoUses          PromoUse[]
  luck               UserLuck[]
}

/// Индивидуальная «удача» игрока, задаётся в админке.
/// kind: case (caseId = конкретный кейс или null = все кейсы), upgrade, contract.
/// value: для case и contract — удача от -100 до 100; для upgrade — множитель шанса (0.1–5).
model UserLuck {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  caseId    String?
  value     Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, kind])
}

/// Глобальные настройки игры (ключ → JSON-значение), правятся в админке.
model Setting {
  key   String @id
  value String
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Item {
  id          String          @id
  weapon      String
  finish      String
  kind        String
  rarity      String
  price       Int
  hue         Int
  pattern     String
  imageUrl    String?
  caseItems   CaseItem[]
  inventory   InventoryItem[]
  battleDrops BattleDrop[]

  @@index([price])
}

model Case {
  id          String          @id
  slug        String          @unique
  name        String
  category    String
  sortOrder   Int
  price       Int
  hue         Int
  icon        String
  imageUrl    String?
  limitTotal  Int?
  limitOpened Int             @default(0)
  isActive    Boolean         @default(true)
  items       CaseItem[]
  drops       InventoryItem[]
}

model CaseItem {
  caseId String
  itemId String
  weight Int
  case   Case   @relation(fields: [caseId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@id([caseId, itemId])
}

model InventoryItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  price     Int
  status    String   @default("owned")
  source    String
  caseId    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  item      Item     @relation(fields: [itemId], references: [id])
  case      Case?    @relation(fields: [caseId], references: [id])

  @@index([userId, status])
  @@index([createdAt])
}

model PromoCode {
  code    String     @id
  amount  Int
  maxUses Int?
  uses    Int        @default(0)
  usedBy  PromoUse[]
}

model PromoUse {
  userId String
  code   String
  user   User      @relation(fields: [userId], references: [id])
  promo  PromoCode @relation(fields: [code], references: [code])

  @@id([userId, code])
}

model Battle {
  id             String         @id @default(cuid())
  mode           String
  crazy          Boolean        @default(false)
  caseIds        String // JSON-массив id кейсов по раундам
  cost           Int
  status         String         @default("waiting")
  currentRound   Int            @default(0)
  winnerTeam     Int?
  serverSeed     String
  serverSeedHash String
  createdById    String
  createdAt      DateTime       @default(now())
  finishedAt     DateTime?
  players        BattlePlayer[]
  drops          BattleDrop[]

  @@index([status, createdAt])
}

model BattlePlayer {
  battleId String
  slot     Int
  team     Int
  userId   String
  total    Int    @default(0)
  battle   Battle @relation(fields: [battleId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@id([battleId, slot])
}

model BattleDrop {
  battleId String
  round    Int
  slot     Int
  itemId   String
  battle   Battle @relation(fields: [battleId], references: [id])
  item     Item   @relation(fields: [itemId], references: [id])

  @@id([battleId, round, slot])
}
