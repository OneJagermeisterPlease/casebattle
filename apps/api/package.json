{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "prisma db push --skip-generate && tsx prisma/seed.ts && tsx src/index.ts",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:force": "SEED_FORCE=1 tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db prisma/dev.db-journal && prisma db push --skip-generate && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@casebattle/shared": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
